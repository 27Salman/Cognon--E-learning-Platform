# ─── Server ───────────────────────────────────────────────
NODE_ENV=production
PORT=5000

# ─── MongoDB ──────────────────────────────────────────────
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority

# ─── JWT ──────────────────────────────────────────────────
JWT_SECRET=
JWT_EXPIRE=7d
# Access token (short-lived, sent via Authorization header)
JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRE=15m
# Refresh token (long-lived, stored in httpOnly cookie)
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRE=7d

# ─── URLs ─────────────────────────────────────────────────
# Frontend origin (used by CORS and Google OAuth redirect)
CLIENT_URL=https://your-production-domain.com
# Backend's own public URL (used by Google OAuth callback)
API_URL=https://your-production-domain.com
# Used for building profile image URLs (non-Cloudinary fallback)
BASE_URL=https://your-production-domain.com

# ─── Email (SMTP) ─────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=

# ─── Google OAuth ─────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── Razorpay ─────────────────────────────────────────────
# Use rzp_live_... keys for production
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Set this from your Razorpay Dashboard > Webhooks
RAZORPAY_WEBHOOK_SECRET=

# ─── Cloudinary ───────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ─── ZegoCloud (Video Calls) ──────────────────────────────
ZEGO_APP_ID=
ZEGO_SERVER_SECRET=

# ─── Admin Setup Script ───────────────────────────────────
# Used only when running: npm run create-admin
ADMIN_EMAIL=
ADMIN_PASSWORD=
